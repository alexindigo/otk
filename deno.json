{
  "nodeModulesDir": "auto",
  "tasks": {
    "start": "deno run --allow-net --allow-read --allow-write --allow-env sidecar/main.ts",
    "dev": "deno run --watch --allow-net --allow-read --allow-write --allow-env sidecar/main.ts",
    "test": "deno test --allow-net --allow-read --allow-write --allow-env --allow-run",
    "check": "deno check sidecar/ protocol/ tests/",
    "lint": "deno lint",
    "fmt": "deno fmt"
  },
  "imports": {
    "@pathfinder/pathfinder": "jsr:@pathfinder/pathfinder@0.2.4",
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@std/path": "jsr:@std/path@1.1.5",
    "@std/toml": "jsr:@std/toml@1.0.11",
    "@std/encoding": "jsr:@std/encoding@1.0.10",
    "jose": "npm:jose@6.1.3",
    "otplib": "npm:otplib@12.0.1",
    "marked": "npm:marked@17.0.6",
    "diff": "npm:diff@8.0.4",
    "ws": "npm:ws@8.21.0"
  },
  "fmt": {
    "exclude": ["node_modules", "web/dist", ".test-state", "config", "LICENSE"]
  },
  "lint": { "exclude": ["node_modules", "web/dist", ".test-state", "config"] }
}
