{
  "workspace": ["./packages/*"],
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "lib": ["deno.ns", "dom", "dom.iterable", "esnext"],
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web"
  },
  "tasks": {
    "start": "deno run --allow-net --allow-read --allow-write --allow-env sidecar/main.ts",
    "dev": "deno run --watch --allow-net --allow-read --allow-write --allow-env sidecar/main.ts",
    "test": "deno test --allow-net --allow-read --allow-write --allow-env --allow-run",
    "check": "deno check packages/ sidecar/ tests/ web/src/ web/vite.config.ts",
    "build:web": "deno run -A npm:vite@8.2.0 build --config web/vite.config.ts",
    "build:web:watch": "deno run -A npm:vite@8.2.0 build --config web/vite.config.ts --watch",
    "test:e2e": "deno test --allow-net --allow-read --allow-write --allow-env --allow-run tests/e2e/",
    "test:unit": "deno task test tests/unit/ packages/*/tests/",
    "test:integration": "deno task test tests/integration/",
    "test:arch": "deno test --allow-read tests/arch/",
    "test:reuse": "deno test tests/reuse/",
    "lint": "deno lint",
    "fmt": "deno fmt"
  },
  "imports": {
    "@pathfinder/pathfinder": "jsr:@pathfinder/pathfinder@0.2.4",
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@std/path": "jsr:@std/path@1.1.5",
    "@std/toml": "jsr:@std/toml@1.0.11",
    "@std/encoding": "jsr:@std/encoding@1.0.10",
    "jose": "npm:jose@6.1.3",
    "otplib": "npm:otplib@12.0.1",
    "fuzzysort": "npm:fuzzysort@3.1.0",
    "shiki": "npm:shiki@4.5.0",
    "shiki/core": "npm:shiki@4.5.0/core",
    "shiki/engine/oniguruma": "npm:shiki@4.5.0/engine/oniguruma",
    "shiki/langs": "npm:shiki@4.5.0/langs",
    "shiki/wasm": "npm:shiki@4.5.0/wasm",
    "@shikijs/stream": "npm:@shikijs/stream@4.5.0",
    "ws": "npm:ws@8.21.0",
    "vite": "npm:vite@8.2.0",
    "@solidjs/vite-plugin": "npm:@solidjs/vite-plugin@3.0.0-next.47",
    "@solidjs/compiler": "npm:@solidjs/compiler@2.0.0-rc.13",
    "solid-js": "npm:solid-js@2.0.0-rc.13",
    "@solidjs/web": "npm:@solidjs/web@2.0.0-rc.13",
    "@solidjs/signals": "npm:@solidjs/signals@2.0.0-rc.13",
    "@fontsource/ibm-plex-mono": "npm:@fontsource/ibm-plex-mono@5.3.0"
  },
  "fmt": {
    "exclude": [
      "node_modules",
      "web/dist",
      ".test-state",
      "./config",
      "LICENSE",
      "packages/*/LICENSE"
    ]
  },
  "lint": { "exclude": ["node_modules", "web/dist", ".test-state", "./config"] }
}
