{
  "name": "otk-browser-tests",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.22.2",
    "npm": "11.19.1"
  },
  "scripts": {
    "test": "playwright test --config playwright.config.ts",
    "scale": "playwright test --config playwright.scale.config.ts",
    "themes": "playwright test --config playwright.themes.config.ts",
    "check": "tsc --noEmit",
    "acceptance:tooling": "playwright test --config playwright.tooling.config.ts --workers=1 --retries=0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.0",
    "typescript": "5.9.3"
  }
}
