    "messages",
    "sessions",
    "revert",
    "attention",
    "menus",
    "visual",
    "transport",
    "harness"
  ],
  "rules": [
    {
      "id": 1,
      "pattern": "(?i)^packages/(ui|client)/.*(prompt|composer|editor|attachment)",
      "areas": ["composer", "attention", "menus"],
      "themes": "style"
    },
    {
      "id": 2,
      "pattern": "(?i)^packages/(ui|client|content)/.*(transcript|message|viewport|highlight|usage)|^packages/content/",
      "areas": ["messages", "sessions", "revert"],
      "themes": "always"
    },
    {
      "id": 3,
      "pattern": "(?i)^packages/(ui|client)/.*(navigation|draft|session.action|task|inbox|shell|project|tabs|panel|sessions)",
      "areas": ["sessions", "revert", "composer", "transport"]
    },
    {
      "id": 4,
      "pattern": "(?i)^packages/(ui|client)/.*(notif|approval|permission|question)",
      "areas": ["attention", "sessions", "composer"]
    },
    {
      "id": 5,
      "pattern": "(?i)^packages/.*(context|command|keymap|dialog|popover|menu)",
      "areas": ["menus", "composer", "sessions", "visual"]
    },
    {
      "id": 6,
      "pattern": "(?i)(theme|\\.css$|/controls/|/fonts?/)",
      "areas": ["visual", "menus", "composer"],
      "themes": "always"
    },
    {
      "id": 8,
      "pattern": "^scripts/|^tests/(support|browser/(fixtures|pages))/|(^|/)(deno\\.(json|lock)|package(-lock)?\\.json|.*config\\.[^/]+)$|^tests/browser/(areas|quarantine)\\.json$",
      "broad": true,
      "themes": "always"
    },
    {
      "id": 9,
      "pattern": "^tests/.*(scale|heap|snapshots)",
      "areas": ["messages", "sessions", "harness"],
      "scale": true
    },
    {
      "id": 10,
      "pattern": "(^|/)[^/]*\\.md$|^LICENSE$",
      "areas": []
    },
    {
      "id": 11,
      "pattern": "^packages/client/(index|server-resources|project-projection|transcript-projection|tabs|task-breadcrumbs|session-tree|transcript-scopes|request-attention|approval-attention|inbox)\\.ts$|^core/(index|ws|digest)/|^core/features/digest[^/]*\\.ts$|^packages/harness/digest(-scheduler)?\\.ts$",
      "areas": ["load"]
    },
    {
      "id": 12,
      "pattern": "^packages/client/(index|server-resources)\\.ts$",
      "broad": true
    },
    {
      "id": 13,
      "pattern": "^core/features/(prompt|prompt-parts|history|files|agents|models|catalogs|commands|frecency|forms)\\.ts$",
      "areas": ["composer", "menus"]
    },
    {
      "id": 14,
      "pattern": "^core/features/(approvals|permissions|questions|request-attention|inbox|inbox-receipts)\\.ts$",
      "areas": ["attention", "sessions"]
    },
    {
      "id": 15,
      "pattern": "^core/features/(sessions|session-actions|session-ids|session-receipts|navigation-default|project-edit|project-scan|layout|shell)\\.ts$",
      "areas": ["sessions", "transport"]
    },
    {
      "id": 16,
      "pattern": "^core/features/revert\\.ts$",
      "areas": ["revert", "messages"]
    },
    {
      "id": 17,
      "pattern": "^core/features/(prefs|storage|usage)\\.ts$",
      "areas": ["visual", "menus", "sessions"]
    },
    {
      "id": 18,
      "pattern": "^core/features/(digests|digest-progress|source|resources|opencode-v2-upgrade)\\.ts$",
      "areas": ["load", "messages", "harness"]
    },
    {
      "id": 19,
      "pattern": "^core/(index|digest)/",
      "areas": ["load", "attention", "sessions"],
      "milestone": true
    },
    {
      "id": 20,
      "pattern": "^core/(ws|http|requests|auth|config|static)/|^core/(service|mod|diagnostics|diagnostics-log)\\.ts$|^(main|application|harness-selection)\\.ts$",
      "areas": ["transport", "load"],
      "milestone": true
    },
    {
      "id": 21,
      "pattern": "^packages/store/",
      "areas": ["sessions", "messages", "load"],
      "milestone": true
    },
    {
      "id": 22,
      "pattern": "^packages/harness(-opencode-v1|-opencode-v2-server)?/",
      "areas": ["harness", "messages", "sessions", "transport"],
      "milestone": true
    },
    {
      "id": 23,
      "pattern": "^packages/protocol/(content|messages)",
      "areas": ["messages"],
      "milestone": true
    },
    {
      "id": 24,
      "pattern": "^packages/protocol/inbox",
      "areas": ["attention", "sessions"],
      "milestone": true
    },
    {
      "id": 25,
      "pattern": "^packages/protocol/requests",
      "areas": ["transport", "composer"],
      "milestone": true
    },
    {
      "id": 26,
      "pattern": "^packages/protocol/(preferences|catalogs|capabilities)/",
      "areas": ["menus", "composer", "visual"],
      "milestone": true
    },
    {
      "id": 27,
      "pattern": "^defaults/",
      "areas": ["visual", "menus", "composer"]
    },
    {
      "id": 28,
      "pattern": "^tests/(unit|arch)/",
      "areas": []
    }
  ]
}
