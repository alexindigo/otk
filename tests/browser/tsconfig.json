{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": true,
    "paths": { "@otk/protocol": ["../../packages/protocol/mod.ts"] }
  },
  "include": [
    "*.config.ts",
    "tooling/**/*.ts",
    "fixtures/**/*.ts",
    "behavior/**/*.ts",
    "contracts/**/*.ts",
    "scale/**/*.ts",
    "themes/**/*.ts",
    "harness/**/*.ts"
  ]
}
